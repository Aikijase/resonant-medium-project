#!/usr/bin/env python3
"""
collapse_from_registry.py
--------------------------------
Reads data/registry.yaml, loads each dataset CSV,
maps them to dimensionless variables (epsilon, gamma=1/Q, omegahat),
and renders universality-collapse plots + a pass/fail report.

Outputs:
  outputs/collapse_eps.png
  outputs/collapse_gamma.png
  outputs/collapse_report.txt
"""

from __future__ import annotations
import sys, math, json
from pathlib import Path
from typing import Dict, Any, Tuple, Optional

import numpy as np
import pandas as pd
import matplotlib.pyplot as plt

# Optional dependency: pyyaml. If missing, we give a friendly hint.
try:
    import yaml
except Exception as e:
    yaml = None

ROOT = Path.home() / "resonant-medium-project"
DATA = ROOT / "data"
OUT  = ROOT / "outputs"
REG_PATH = DATA / "registry.yaml"

# ------------------
# helpers for "normalize" expressions
# ------------------
def min_nonzero(series: pd.Series) -> float:
    s = series.to_numpy()
    s = s[s != 0]
    return float(np.min(s)) if s.size else 1.0

def normalize(x) -> np.ndarray:
    x = np.asarray(x, float)
    lo, hi = np.nanmin(x), np.nanmax(x)
    if not np.isfinite(lo) or not np.isfinite(hi) or hi-lo <= 0:
        return np.zeros_like(x)
    return (x - lo) / (hi - lo + 1e-12)

def omega_L_at_kmin(df: pd.DataFrame) -> float:
    # Convenience for dusty plasma: omega0 = omega_L at smallest k
    if "omega_L" in df.columns and "k" in df.columns:
        idx = df["k"].idxmin()
        return float(df.loc[idx, "omega_L"])
    if "omega_L_norm" in df.columns:
        return 1.0
    return 1.0

def map_dispersion_to_eps(omega_L, k):
    """
    Placeholder: map dispersion to an "epsilon-like" localization proxy.
    Here we scale omega_L relative to its min; feel free to refine later.
    """
    w = np.asarray(omega_L, float)
    return normalize(w)

SAFE_FUNCS = {
    "np": np,
    "min_nonzero": min_nonzero,
    "normalize": normalize,
    "omega_L_at_kmin": omega_L_at_kmin,
    "map_dispersion_to_eps": map_dispersion_to_eps,
    "abs": abs, "sqrt": math.sqrt, "log": math.log, "exp": math.exp
}

def eval_rule(rule: str, df: pd.DataFrame, extra: Dict[str, Any]) -> Any:
    """
    Evaluate a small expression rule with pandas/NumPy context.
    'extra' can inject named arrays or scalars.
    """
    env = {**SAFE_FUNCS, **{c: df[c] for c in df.columns}, **extra}
    try:
        return pd.eval(rule, engine="python", parser="pandas", local_dict=env)
    except Exception:
        # fallback to Python eval for functions like omega_L_at_kmin(df)
        env2 = {**env, "df": df}
        return eval(rule, {"__builtins__": {}}, env2)

# ------------------
# loader
# ------------------
def load_registry(path: Path) -> Dict[str, Any]:
    if not path.exists():
        raise FileNotFoundError(
            f"Registry file not found at:\n  {path}\n"
            "Create it (see template printed below) and re-run."
        )
    if yaml is None:
        raise RuntimeError(
            "PyYAML not installed in this environment.\n"
            "Install it inside your venv:  pip install pyyaml\n"
            f"Then re-run:  python {Path(__file__).name}"
        )
    return yaml.safe_load(open(path, "r"))

def load_dataset_files(files) -> pd.DataFrame:
    dfs = []
    for f in files:
        fp = ROOT / f if not str(f).startswith("/") else Path(f)
        if not fp.exists():
            raise FileNotFoundError(f"Missing data file: {fp}")
        dfs.append(pd.read_csv(fp))
    return pd.concat(dfs, ignore_index=True)

# ------------------
# main normalize step
# ------------------
def normalize_item(name: str, item: Dict[str, Any]) -> Optional[pd.DataFrame]:
    """
    Returns a DataFrame with subset of columns:
      omegahat, epsilon, gamma
    Some datasets might only provide epsilon vs mode index etc.;
    we include whatever is available.
    """
    try:
        df = load_dataset_files(item["files"])
    except Exception as e:
        print(f"[{name}] ERROR loading files: {e}", file=sys.stderr)
        return None

    # 1) Rename/ensure dtypes if fields declared
    fields = item.get("fields", {})
    for col, typ in fields.items():
        if col in df.columns:
            if typ == "int":   df[col] = df[col].astype(int, errors="ignore")
            if typ == "float": df[col] = df[col].astype(float, errors="ignore")

    # 2) Build any helper scalars used by rules
    extra: Dict[str, Any] = {}
    # common baseline frequency f0 or omega0
    if "f_hz" in df.columns:
        extra["f0"] = float(np.nanmin(df["f_hz"][df["f_hz"]>0])) if (df["f_hz"]>0).any() else 1.0
    if "omega" in df.columns:
        extra["omega0"] = float(np.nanmin(df["omega"][df["omega"]>0])) if (df["omega"]>0).any() else 1.0
    if "omega_L" in df.columns:
        extra["omega0"] = omega_L_at_kmin(df)

    # 3) Apply normalize rules from registry
    rules = item.get("normalize", {})
    out = pd.DataFrame(index=df.index)

    # omegahat: allow several possible sources
    if "omegahat" in rules:
        out["omegahat"] = eval_rule(rules["omegahat"], df, extra)
    else:
        # try common fallbacks
        if "f_hz" in df.columns and "f0" in extra:
            out["omegahat"] = df["f_hz"] / extra["f0"]
        elif "omega" in df.columns and "omega0" in extra:
            out["omegahat"] = df["omega"] / extra["omega0"]
        elif "omega_L" in df.columns and "omega0" in extra:
            out["omegahat"] = df["omega_L"] / extra["omega0"]

    # epsilon mapping rule
    if "eps" in rules:
        out["epsilon"] = eval_rule(rules["eps"], df, extra)
    elif "E_anchor_ratio" in df.columns:
        out["epsilon"] = normalize(df["E_anchor_ratio"])
    elif "gorkov_U" in df.columns:
        out["epsilon"] = normalize(df["gorkov_U"])
    elif "omega_L" in df.columns:
        out["epsilon"] = map_dispersion_to_eps(df["omega_L"], df.get("k", df.index))

    # gamma mapping rule (prefer 1/Q if Q available)
    if "gamma" in rules:
        out["gamma"] = eval_rule(rules["gamma"], df, extra)
    elif "Q" in df.columns:
        q = np.asarray(df["Q"], float)
        out["gamma"] = 1.0 / np.clip(q, 1e-9, None)

    out["dataset"] = name
    # drop rows that lack both epsilon/gamma and omegahat
    if "omegahat" not in out.columns:
        out["omegahat"] = np.nan
    good = out.dropna(subset=["omegahat"], how="all")
    if good.empty:
        print(f"[{name}] WARNING: nothing to plot after normalization.")
        return None
    return good

# ------------------
# plotting & pass/fail
# ------------------
def collapse_plot(df_all: pd.DataFrame, ykey: str, title: str, outfile: Path,
                  tol_frac: float = 0.10) -> Tuple[float, float]:
    """
    Plot all datasets on (omegahat, ykey). Build master curve (bin-median)
    and compute RMS fractional deviation. For epsilon we first do a per-dataset
    min-max normalization and optional flip (shape universality test).
    """
    df = df_all.copy()

    # --- Per-dataset ε alignment (shape-only) ---
    if ykey == "epsilon":
        lines = []
        for name, g in df.groupby("dataset"):
            y = g[ykey].to_numpy(dtype=float)
            if not np.isfinite(y).any():
                continue
            lo, hi = np.nanmin(y), np.nanmax(y)
            if not np.isfinite(lo) or not np.isfinite(hi) or hi - lo <= 0:
                continue
            y2 = (y - lo) / (hi - lo + 1e-12)

            x = g["omegahat"].to_numpy(dtype=float)
            m = np.isfinite(x) & np.isfinite(y2)
            corr = np.corrcoef(x[m], y2[m])[0, 1] if m.sum() > 2 else 1.0
            flipped = False
            if np.isfinite(corr) and corr < 0:
                y2 = 1.0 - y2
                flipped = True

            df.loc[g.index, ykey] = y2
            lines.append(f"{name}: minmax → [0,1]{' + flip' if flipped else ''}")

        OUT.mkdir(parents=True, exist_ok=True)
        (OUT / "affine_report.txt").write_text("\n".join(lines) + "\n")

    # --- Plot datasets ---
    plt.figure()
    for name, g in df.groupby("dataset"):
        if ykey not in g.columns:
            continue
        plt.plot(g["omegahat"], g[ykey], 'o', linestyle='none', label=name, alpha=0.8)

    # --- Master curve via bin-median ---
    xmin = float(np.nanmin(df["omegahat"]))
    xmax = float(np.nanmax(df["omegahat"]))
    bins = np.linspace(xmin, xmax, 16)
    centers = 0.5 * (bins[:-1] + bins[1:])
    med = []
    for i in range(len(bins) - 1):
        sel = (df["omegahat"] >= bins[i]) & (df["omegahat"] < bins[i + 1])
        y = df.loc[sel, ykey]
        med.append(np.nanmedian(y) if np.any(sel) else np.nan)
    med = np.asarray(med)
    plt.plot(centers, med, '-', label="master (bin-median)")

    plt.xlabel(r'$\hat{\omega}$'); plt.ylabel(ykey)
    plt.title(title); plt.legend()
    OUT.mkdir(parents=True, exist_ok=True)
    plt.tight_layout(); plt.savefig(outfile.as_posix(), dpi=150, bbox_inches="tight")
    plt.close()

    # --- RMS fractional deviation ---
    rms_list = []
    for name, g in df.groupby("dataset"):
        if ykey not in g.columns:
            continue
        mask = np.isfinite(med)
        if not mask.any():
            continue
        master = np.interp(g["omegahat"], centers[mask], med[mask], left=np.nan, right=np.nan)
        num = g[ykey].to_numpy(dtype=float)
        good = np.isfinite(master) & np.isfinite(num) & (np.abs(master) > 1e-12)
        if not good.any():
            continue
        frac = (num[good] - master[good]) / master[good]
        rms_list.append(np.sqrt(np.nanmean(frac**2)))
    rms = float(np.nanmean(rms_list)) if rms_list else np.inf
    return rms, tol_frac

def main():
    # Load registry
    try:
        reg = load_registry(REG_PATH)
    except Exception as e:
        print(e, file=sys.stderr)
        print("\n--- registry.yaml template ---\n")
        print("""benchmarks:
  ABH_MaCheng:
    files: ["data/benchmarks/ABH_plate_benchmark.csv"]
    fields: {mode_index: int, f_hz: float, E_anchor_ratio: float, Q: float}
    normalize:
      omegahat: "f_hz / f0"      # or leave blank and it will infer
      eps: "E_anchor_ratio"      # -> epsilon
      gamma: "1.0 / Q"           # -> gamma

  DustyPlasma_PK4:
    files: ["data/pk4/dispersion.csv"]
    fields: {k: float, omega_L: float, omega_T: float}
    normalize:
      omegahat: "omega_L / omega_L_at_kmin(df)"
      eps: "map_dispersion_to_eps(omega_L, k)"

  BEC_Hawking:
    files: ["data/bec_hawking/ridge_lines.csv"]
    fields: {k: float, corr_amp: float, omega: float}
    normalize:
      omegahat: "omega / omega0"
      eps: "normalize(corr_amp)"

  StableLev:
    files: ["data/levitation/stablelev_features.csv"]
    fields: {ka: float, gorkov_U: float}
    normalize:
      omegahat: "ka"             # as a proxy if freq absent
      eps: "normalize(gorkov_U)"
""")
        sys.exit(1)

    # Normalize all entries
    blocks = []
    for name, item in reg.get("benchmarks", {}).items():
        norm = normalize_item(name, item)
        if norm is not None:
            blocks.append(norm)

    if not blocks:
        print("No datasets normalized; check your registry/file paths.")
        sys.exit(2)

    ALL = pd.concat(blocks, ignore_index=True)

    # Build plots and report
    report_lines = []

    if "epsilon" in ALL.columns:
        rms_eps, tol = collapse_plot(
            ALL.dropna(subset=["epsilon", "omegahat"]),
            "epsilon",
            "Universality collapse: epsilon vs omegahat",
            OUT / "collapse_eps.png",
            tol_frac=0.10
        )
        report_lines.append(f"epsilon collapse RMS frac = {rms_eps:.3f}  (threshold {tol:.2f})  => {'PASS' if rms_eps <= tol else 'FAIL'}")
    else:
        report_lines.append("epsilon: no datasets provided epsilon; skipping.")

    if "gamma" in ALL.columns:
        rms_gam, tol = collapse_plot(
            ALL.dropna(subset=["gamma", "omegahat"]),
            "gamma",
            "Universality collapse: gamma vs omegahat",
            OUT / "collapse_gamma.png",
            tol_frac=0.10
        )
        report_lines.append(f"gamma collapse RMS frac = {rms_gam:.3f}   (threshold {tol:.2f})  => {'PASS' if rms_gam <= tol else 'FAIL'}")
    else:
        report_lines.append("gamma: no datasets provided gamma; skipping.")

    # After reporting, fit master curve for epsilon
    if "epsilon" in ALL.columns:
        fit_and_save_master(ALL, "epsilon", "collapse_eps")

    OUT.mkdir(parents=True, exist_ok=True)
    rep_path = OUT / "collapse_report.txt"
    rep_path.write_text("\n".join(report_lines))
    print("\n".join(report_lines))
    print(f"Wrote {rep_path.as_posix()}")
    print(f"Wrote {(OUT/'collapse_eps.png').as_posix()} (if epsilon present)")
    print(f"Wrote {(OUT/'collapse_gamma.png').as_posix()} (if gamma present)")

# ------------------
# master-fit utility (logistic or exp-law)
# ------------------
# ------------------
# master-fit utility (logistic or exp-law)
# ------------------
def fit_master_curve(x, y, model="exp"):
    from scipy.optimize import curve_fit
    x = np.asarray(x, float); y = np.asarray(y, float)
    m = np.isfinite(x) & np.isfinite(y)
    x, y = x[m], y[m]
    if x.size < 4:
        raise RuntimeError("Not enough points to fit master curve.")

    # Shift & clip x to avoid negative bases for fractional powers
    x = np.clip(x - np.nanmin(x), 0.0, None) + 1e-9

    if model == "logistic":
        def f(z, A, w0, p):
            return A / (1.0 + np.exp(-(z - w0) / np.clip(p, 1e-9, None)))
        bounds = ([0.0, 0.0, 1e-3], [2.0, np.nanmax(x)*2 + 1.0, 10.0])
    else:  # exponential rise
        def f(z, A, w0, p):
            return A * (1.0 - np.exp(- (z / np.clip(w0, 1e-9, None)) ** np.clip(p, 1e-3, None)))
        bounds = ([0.0, 1e-6, 1e-3], [2.0, np.nanmax(x)*2 + 1.0, 10.0])

    popt, pcov = curve_fit(f, x, y, p0=[1.0, np.median(x)+1e-3, 1.0],
                           bounds=bounds, maxfev=20000)
    return popt, pcov, f, x, y

def r2_score(y, yhat):
    m = np.isfinite(y) & np.isfinite(yhat)
    if m.sum() < 2: return np.nan
    ss_res = np.sum((y[m] - yhat[m])**2)
    ss_tot = np.sum((y[m] - np.mean(y[m]))**2)
    return 1.0 - ss_res / (ss_tot + 1e-12)

def fit_and_save_master(df_all: pd.DataFrame, ykey: str, outfile_prefix: str):
    """Fit a universal curve to the (shape-aligned) data and save params + overlay."""
    if ykey not in df_all.columns:
        return

    # Re-apply same ε alignment used in plotting (shape-only)
    df_fit = df_all.copy()
    if ykey == "epsilon":
        for name, g in df_fit.groupby("dataset"):
            y = g[ykey].to_numpy(float)
            lo, hi = np.nanmin(y), np.nanmax(y)
            if np.isfinite(lo) and np.isfinite(hi) and hi > lo:
                y2 = (y - lo) / (hi - lo + 1e-12)
                x = g["omegahat"].to_numpy(float)
                m = np.isfinite(x) & np.isfinite(y2)
                corr = np.corrcoef(x[m], y2[m])[0,1] if m.sum() > 2 else 1.0
                if np.isfinite(corr) and corr < 0:
                    y2 = 1.0 - y2
                df_fit.loc[g.index, ykey] = y2

    x = df_fit["omegahat"].to_numpy(float)
    y = df_fit[ykey].to_numpy(float)

    # Try both models and keep the one with better R²
    best = None
    for model in ("exp", "logistic"):
        try:
            popt, pcov, f, xx, yy = fit_master_curve(x, y, model=model)
            yhat = f(xx, *popt)
            r2 = r2_score(yy, yhat)
            if (best is None) or (r2 > best["r2"]):
                best = dict(model=model, popt=popt, pcov=pcov, f=f, xx=xx, yy=yy, r2=r2)
        except Exception:
            continue

    if best is None:
        print("Master fit failed for", ykey)
        return

    A, w0, p = best["popt"]
    params = dict(model=best["model"], A=float(A), w0=float(w0), p=float(p), R2=float(best["r2"]))
    OUT.mkdir(parents=True, exist_ok=True)
    outj = OUT / f"{outfile_prefix}_fit.json"
    json.dump(params, open(outj, "w"), indent=2)

# ------------------
# Auto-rescale test
# ------------------
def auto_rescale_universality(df_all: pd.DataFrame, ykey="epsilon",
                              master_model="logistic"):
    """Finds per-dataset horizontal rescale factors s_d minimizing RMS to the universal curve."""
    from scipy.optimize import minimize_scalar
    if ykey not in df_all.columns:
        return None

    # Fit the master curve once (reuse same logic as fit_master_curve)
    x = np.asarray(df_all["omegahat"], float)
    y = np.asarray(df_all[ykey], float)
    popt, pcov, f, xx, yy = fit_master_curve(x, y, model=master_model)

    master = lambda x_: f(x_, *popt)
    results = []

    for name, g in df_all.groupby("dataset"):
        xg = np.asarray(g["omegahat"], float)
        yg = np.asarray(g[ykey], float)
        m = np.isfinite(xg) & np.isfinite(yg)
        if not m.any():
            continue

        def rms_for_scale(s):
            yhat = master(np.clip(xg[m]*s, np.nanmin(xx), np.nanmax(xx)))
            return np.sqrt(np.nanmean((yg[m] - yhat)**2))

        res = minimize_scalar(rms_for_scale, bounds=(0.3, 3.0), method="bounded")
        results.append((name, res.x, res.fun))

    OUT.mkdir(parents=True, exist_ok=True)
    out_csv = OUT / "collapse_rescale_results.csv"
    pd.DataFrame(results, columns=["dataset", "scale_s", "rms"]).to_csv(out_csv, index=False)
    print(f"[AUTO-RESCALE] Saved → {out_csv}")
    return results
   # Smooth overlay plot
    xx_full = np.linspace(np.nanmin(best["xx"]), np.nanmax(best["xx"]), 400)
    yy_full = best["f"](xx_full, *best["popt"])
    plt.figure()
    for name, g in df_fit.groupby("dataset"):
        plt.plot(g["omegahat"], g[ykey], "o", label=name, alpha=0.7)
    plt.plot(xx_full, yy_full, "k-", lw=2, label=f"fit ({best['model']}, R²={best['r2']:.3f})")
    plt.xlabel(r"$\hat{\omega}$"); plt.ylabel(ykey)
    plt.title(f"Universal fit ({ykey})")
    plt.legend(); plt.tight_layout()
    outp = OUT / f"{outfile_prefix}_fit.png"
    plt.savefig(outp, dpi=150, bbox_inches="tight"); plt.close()
    print(f"Saved fit parameters → {outj}")
    print(f"Saved overlay plot → {outp}")

# ------------------
# main entrypoint
# ------------------
if __name__ == "__main__":
    main()
    # After main() prints the collapse report, fit the master curve for epsilon
    try:
        # Recreate the combined dataframe the same way main() does
        reg = load_registry(REG_PATH)
        blocks = []
        for name, item in reg.get("benchmarks", {}).items():
            norm = normalize_item(name, item)
            if norm is not None:
                blocks.append(norm)
        if blocks:
            ALL = pd.concat(blocks, ignore_index=True)
            if "epsilon" in ALL.columns:
                fit_and_save_master(ALL.dropna(subset=["epsilon", "omegahat"]),
                                    "epsilon", "collapse_eps")
    except Exception as e:
        print("Fit step skipped:", e)
