\subsection{Error propagation and priors}\label{subsec:error_propagation_priors}
\paragraph{Error propagation.}
Uncertainties in the operator parameters $\theta \equiv (\Kphi, \softness, \wstar)$ are propagated via linear error propagation about the MAP point. For observable $\mathcal{O}$,
\begin{equation}
  \mathrm{Cov}[\mathcal{O}] \approx J_{\mathcal{O}\!,\,\theta}\,
  \mathrm{Cov}[\theta]\; J_{\mathcal{O}\!,\,\theta}^{\top},
  \qquad
  (J_{\mathcal{O}\!,\,\theta})_{ij} \equiv \left.\frac{\partial \mathcal{O}_{i}}{\partial \theta_{j}}\right|_{\theta=\theta_{\rm MAP}}.
\end{equation}

\paragraph{Guard conditions.}
Non-physical solutions are rejected by smoothness/sign checks in the sampler.

\paragraph{Priors.}
\begin{equation}
  \Kphi \in [0,\,1], \quad
  \softness \in (0,\,1], \quad
  \wstar \in [0,\,5]~\text{rad/e-fold}.
\end{equation}
We use standard probes \cite{Planck2018,PantheonPlus2022,DESI2024_BAO_DR1}.

