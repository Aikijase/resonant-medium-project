import argparse, json, math, os, numpy as np, pandas as pd
from growth import solve_growth

def aic_bic(chi2, k, n): AIC = chi2 + 2*k; BIC = chi2 + k*math.log(max(n,1)); return AIC, BIC
def wwi(dA,dB): return 100*min(1.0,max(0,-dA/10.0),max(0,-dB/10.0)) if dA is not None and dB is not None else None

if __name__ == "__main__":
    ap = argparse.ArgumentParser()
    ap.add_argument("--in", dest="cfg", required=True)
    ap.add_argument("--data", default="data/growth/fs8_catalog.csv")
    ap.add_argument("--out", dest="out", required=True)
    ap.add_argument("--ref", dest="ref", default="")
    ap.add_argument("--fit-s8", action="store_true", help="fit a global amplitude alpha to fs8_pred")
    args = ap.parse_args()

    import tomllib
    with open(args.cfg, "rb") as fh: P = tomllib.load(fh)["params"]

    sol = solve_growth(P)
    z_pred, fs8_pred = np.asarray(sol["z"]), np.asarray(sol["fs8"])
    D = pd.read_csv(args.data)
    y  = np.interp(D["z"].values, z_pred, fs8_pred)
    d, s = D["fs8_obs"].values, D["sigma"].values

    alpha, k = 1.0, 0
    if args.fit_s8:
        w = 1.0/(s*s)
        num = np.sum(w * d * y)
        den = np.sum(w * y * y) + 1e-12
        alpha = float(num/den)
        k = 1  # one fitted parameter
    yfit = alpha * y

    chi2 = float(np.sum(((yfit - d)/s)**2))
    n = int(len(D))
    AIC, BIC = aic_bic(chi2, k, n)

    res = {"probe":"fs8","n":n,"k":k,"chi2":chi2,
           "alpha":alpha if args.fit_s8 else None,
           "AIC":{"value":AIC,"delta":None},
           "BIC":{"value":BIC,"delta":None},
           "WWI":None}

    if args.ref:
        try:
            R = json.load(open(args.ref))
            dA = AIC - R["AIC"]["value"]; dB = BIC - R["BIC"]["value"]
            res["AIC"]["delta"] = dA; res["BIC"]["delta"] = dB; res["WWI"] = wwi(dA,dB)
        except Exception: pass

    os.makedirs(os.path.dirname(args.out), exist_ok=True)
    pd.DataFrame({"z": z_pred, "fs8_pred": fs8_pred, "fs8_fit": yfit}).to_csv(args.out.replace(".json",".csv"), index=False)
    json.dump(res, open(args.out,"w"), indent=2)
    print(f"Wrote {args.out} and {args.out.replace('.json','.csv')}")
